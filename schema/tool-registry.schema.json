{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/framework/schema/tool-registry.schema.json",
  "title": "Tool registry",
  "description": "Every framework-level tool a role can list under tools:. Pack command tools are defined in the packs themselves.",
  "type": "object",
  "required": ["kind", "version", "tools"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "tool_registry" },
    "version": { "$ref": "role.schema.json#/$defs/semver" },
    "mcp_servers": {
      "description": "MCP servers that back some tools.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["command"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": { "type": "array", "items": { "type": "string" }, "description": "Env var names passed through (values never stored here)." }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "impl", "effect", "guarded_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "role.schema.json#/$defs/toolRef" },
          "description": { "type": "string", "description": "Shown to the LLM. Say when to use it, not just what it does." },
          "impl": {
            "oneOf": [
              {
                "type": "object",
                "required": ["builtin"],
                "additionalProperties": false,
                "properties": { "builtin": { "type": "string", "description": "Python import path, module:function." } }
              },
              {
                "type": "object",
                "required": ["mcp_server", "mcp_tool"],
                "additionalProperties": false,
                "properties": {
                  "mcp_server": { "type": "string" },
                  "mcp_tool": { "type": "string" }
                }
              }
            ]
          },
          "effect": {
            "description": "read: no side effects. local: changes the working copy or local state. remote: changes something outside this machine (GitHub, CloudHub).",
            "enum": ["read", "local", "remote"]
          },
          "guarded_by": {
            "description": "Which permission fields are enforced before the call runs. 'none' only for tools with no access to files, commands or network.",
            "type": "array",
            "items": { "enum": ["fs_read", "fs_write", "fs_deny", "commands_allow", "network", "git", "none"] },
            "minItems": 1
          },
          "args": {
            "description": "JSON Schema for the arguments, passed to the LLM as the tool's input schema.",
            "type": "object"
          }
        }
      }
    }
  }
}
